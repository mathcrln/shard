{
	"name": "shard",
	"version": "0.1.0",
	"private": true,
	"description": "An action-focused bar to find notes, run commands, and create notes from models.",
	"keywords": [],
	"license": "0-BSD",
	"author": "Mathieu Céraline <oss@mathcrln.com>",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "pnpm typecheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "eslint .",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit && tsc -p tests",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"happy-dom": "20.14.6",
		"obsidian": "1.14.4",
		"oxfmt": "0.75.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.28.0"
}
